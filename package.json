{
  "name": "suno-client",
  "version": "0.1.0",
  "description": "Typed Suno client for Node with response-drift detection and a live canary",
  "keywords": [
    "suno",
    "suno-ai",
    "music",
    "ai-music",
    "generative-music",
    "unofficial-api",
    "typescript",
    "twitch",
    "lyrics",
    "beat-grid"
  ],
  "homepage": "https://github.com/theslumdogemillionaire/suno-client#readme",
  "bugs": {
    "url": "https://github.com/theslumdogemillionaire/suno-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theslumdogemillionaire/suno-client.git"
  },
  "license": "WTFPL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "suno-client": "./dist/esm/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run gen:baselines && rimraf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:live": "vitest run tests/live --testTimeout=600000",
    "canary": "tsx scripts/canary.ts",
    "lint": "tsc --noEmit",
    "record-baselines": "tsx scripts/record-baselines.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package",
    "gen:baselines": "node scripts/gen-baselines.mjs",
    "check:package": "publint && attw --pack ."
  },
  "dependencies": {
    "node-id3": "^0.2.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.10.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "module": "./dist/esm/index.js",
  "publishConfig": {
    "access": "public"
  }
}
