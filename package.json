{
  "name": "suno-client",
  "version": "0.1.0",
  "description": "Typed Suno client for Node with response-drift detection and a live canary",
  "keywords": [
    "suno",
    "suno-ai",
    "music",
    "ai-music",
    "generative-music",
    "unofficial-api",
    "typescript",
    "twitch",
    "lyrics",
    "beat-grid"
  ],
  "homepage": "https://github.com/theslumdogemillionaire/suno-client#readme",
  "bugs": {
    "url": "https://github.com/theslumdogemillionaire/suno-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theslumdogemillionaire/suno-client.git"
  },
  "license": "WTFPL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "suno-client": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:live": "vitest run tests/live --testTimeout=600000",
    "canary": "tsx scripts/canary.ts",
    "lint": "tsc --noEmit",
    "record-baselines": "tsx scripts/record-baselines.ts",
    "smoke": "tsx scripts/smoke.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "node-id3": "^0.2.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
